server:
  host: "0.0.0.0"
  port: 8000

auth:
  api_keys:
    - "change-me-to-a-secure-random-key"

aws:
  region: "us-east-1"
  log_group_prefix: "/trailhead"
  # Set true to auto-create log groups on first ingest per owner.
  # When false, groups must be pre-created as /trailhead/{owner}.
  auto_create_groups: false

ingest:
  # Max events per CloudWatch PutLogEvents call (hard cap: 10,000)
  max_batch_events: 10000
  # Max bytes per batch (hard cap: 1,048,576)
  max_batch_bytes: 1048576
